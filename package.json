{
  "name": "sippy-water-pet",
  "displayName": "Sippy — Virtual Hydration Pet",
  "description": "A compact cozy pixel-art Sippy pet for VS Code Explorer: feed, pat, rest, and water reminders.",
  "version": "0.8.5",
  "publisher": "fiona-studio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sippy.open",
        "title": "Sippy: Open Pet Room"
      },
      {
        "command": "sippy.logWater",
        "title": "Sippy: Log Water"
      },
      {
        "command": "sippy.feed",
        "title": "Sippy: Feed Sippy"
      },
      {
        "command": "sippy.toggleSound",
        "title": "Sippy: Toggle Sound"
      },
      {
        "command": "sippy.toggleSleep",
        "title": "Sippy: Put to Sleep / Wake Up"
      },
      {
        "command": "sippy.resetToday",
        "title": "Sippy: Reset Today's Water"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sippy.petView",
          "name": "Sippy's Room",
          "type": "webview",
          "icon": "media/sippy-icon.svg",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Sippy",
      "properties": {
        "sippy.dailyGoal": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Daily water goal in ml."
        },
        "sippy.reminderMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 5,
          "maximum": 240,
          "description": "Minutes between reminders while VS Code is running."
        },
        "sippy.remindersEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code hydration reminders."
        },
        "sippy.codingReactions": {
          "type": "boolean",
          "default": true,
          "description": "Let Sippy react to saves, task results, git commits and error counts."
        },
        "sippy.sound": {
          "type": "boolean",
          "default": true,
          "description": "Play Sippy's little retro sounds (sips, munching, cheers, yawns, sniffles)."
        },
        "sippy.soundVolume": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "maximum": 100,
          "description": "Volume of Sippy's sounds, from 0 to 100."
        }
      }
    }
  },
  "scripts": {
    "test": "node tests/test-extension.cjs",
    "check": "node --check extension.js && node tests/test-extension.cjs"
  },
  "icon": "media/sippy-publisher-icon.png",
  "keywords": [
    "pet",
    "water",
    "hydration",
    "penguin",
    "tamagotchi",
    "virtual pet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noblesse013/sippy-vscode-pets.git"
  },
  "bugs": {
    "url": "https://github.com/Noblesse013/sippy-vscode-pets/issues"
  },
  "homepage": "https://github.com/Noblesse013/sippy-vscode-pets#readme"
}
